<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="edu.westga.cs3211.p1.viewmodel.RemoveStockCookController">

	<top>
		<HBox spacing="10" alignment="CENTER"
			style="-fx-background-color: #2c3e50; -fx-padding: 15;">
			<Label
				text="Pirate Ship Inventory System - Cook Remove Food Stock"
				style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;" />
		</HBox>
	</top>

	<center>
		<VBox spacing="15" alignment="TOP_CENTER"
			style="-fx-padding: 20;">
			<Label text="Food Inventory"
				style="-fx-font-size: 16px; -fx-font-weight: bold;" />


			<ListView fx:id="foodListView" VBox.vgrow="ALWAYS"
				prefWidth="800" prefHeight="300">
				<VBox.margin>
					<Insets bottom="10" />
				</VBox.margin>
			</ListView>


			<VBox spacing="5" alignment="TOP_LEFT"
				style="-fx-padding: 10; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 5;">
				<Label text="Reason for Removal:"
					style="-fx-font-weight: bold;" />
				<TextField fx:id="reasonTextField" prefWidth="400"
					promptText="Enter reason for removing this food item..." />
			</VBox>


			<Label fx:id="errorLabel"
				style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" />

			<!-- Remove Button -->
			<Button text="Remove Selected Food Item"
				onAction="#onRemoveStock"
				style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"
				prefWidth="250" />
		</VBox>
	</center>

	<bottom>
		<HBox spacing="20" alignment="CENTER"
			style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
			<Button text="Home" onAction="#onHomeButton"
				style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;" />
			<Button text="Logout" onAction="#onLogout"
				style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;" />
		</HBox>
	</bottom>

</BorderPane>